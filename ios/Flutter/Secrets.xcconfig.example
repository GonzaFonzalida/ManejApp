// Copiar este archivo como Secrets.xcconfig y completar los valores.
// NO commitear Secrets.xcconfig (ya está en .gitignore).

// Google Maps SDK
GOOGLE_MAPS_API_KEY=TU_GOOGLE_MAPS_API_KEY

// Google Sign-In (iOS OAuth 2.0 client ID)
// Crear en: https://console.cloud.google.com/apis/credentials?project=manejapp-89679
// Tipo: iOS — Bundle ID: com.gonzalofonzalida.manejapp
GOOGLE_SIGN_IN_IOS_CLIENT_ID=XXXX-YYYY.apps.googleusercontent.com
GOOGLE_SIGN_IN_IOS_URL_SCHEME=com.googleusercontent.apps.XXXX-YYYY
