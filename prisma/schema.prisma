generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

model User {
  id          Int           @id @default(autoincrement())
  name        String
  surname     String
  email       String        @unique
  password    String
  dni         String        @unique
  createdAt   DateTime      @default(now())
  birthDate   DateTime
  isActive    Boolean       @default(true)
  role        Role

  student     Student?
  instructor  Instructor?
  admin       Admin?
}

model Student {
  id      Int  @id
  user    User @relation(fields: [id], references: [id])
  // Campos propios del alumno
  // ...
}

model Car {
  id           Int      @id @default(autoincrement())
  brand        String
  model        String
  year         Int
  licensePlate String   @unique
  transmission Transmission

  instructor   Instructor?
}

model Instructor {
  id              Int  @id
  user            User @relation(fields: [id], references: [id])
  licenseNumber   String
  experienceYears Int
  available       Boolean @default(true)
  isValid         Boolean @default(false) // Se valida por un Admin

  carId           Int?
  car             Car? @relation(fields: [carId], references: [id])

  permissions     InstructorPermission[]
}

model Admin {
  id      Int  @id
  user    User @relation(fields: [id], references: [id])
  // Campos propios del administrador/cliente
  companyName String
}



model Permission {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  isMandatory Boolean  @default(true)

  instructors InstructorPermission[]
}

model InstructorPermission {
  instructorId Int
  permissionId Int
  granted      Boolean     @default(false)

  instructor   Instructor  @relation(fields: [instructorId], references: [id])
  permission   Permission  @relation(fields: [permissionId], references: [id])

  @@id([instructorId, permissionId])
}

