generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

model User {
  id          Int       @id @default(autoincrement())
  name        String
  surname     String
  email       String    @unique
  password    String
  dni         String    @unique
  createdAt   DateTime  @default(now())
  birthDate   DateTime
  isActive    Boolean   @default(false)
  role        Role      @default(STUDENT)
  lastLoginAt DateTime? // opcional: útil para auditoría
  sessions    Session[]


  student     Student?
  instructor  Instructor?
  admin       Admin?

  @@index([role])
}

model Session {
  id           String   @id @default(uuid())
  userId       Int
  // Guarda el refresh token hasheado para poder invalidarlo sin exponerlo
  refreshHash  String   @unique
  userAgent    String?
  ip           String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}



model Student {
  id      Int   @id @default(autoincrement())
  userId  Int   @unique
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Car {
  id           Int         @id @default(autoincrement())
  brand        String
  model        String
  year         Int
  licensePlate String      @unique
  transmission Transmission

  instructorId Int      
  instructor   Instructor?  @relation(fields: [instructorId], references: [id])
}

model Instructor {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber   String
  experienceYears Int
  available       Boolean   @default(true)
  isValid         Boolean   @default(false)

  cars      Car[]  
  permissions     InstructorPermission[]
}

model Admin {
  id      Int  @id
  user    User @relation(fields: [id], references: [id])
  // Campos propios del administrador/cliente
  companyName String
} 

model Permission {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  isMandatory Boolean  @default(true)

  instructors InstructorPermission[]
}

model InstructorPermission {
  instructorId Int
  permissionId Int
  granted      Boolean     @default(false)

  instructor   Instructor  @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  permission   Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([instructorId, permissionId])
}
