generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

model User {
  id          Int       @id @default(autoincrement())
  name        String
  surname     String
  email       String    @unique
  password    String
  dni         String    @unique
  createdAt   DateTime  @default(now())
  birthDate   DateTime
  isActive    Boolean   @default(false)
  role        Role      @default(STUDENT)
  lastLoginAt DateTime? // opcional: útil para auditoría
  sessions    Session[]
  
  
  student     Student?
  instructor  Instructor?
  admin       Admin?
  
  @@index([role])
}

model Session {
  id           String   @id @default(uuid())
  userId       Int
  // Guarda el refresh token hasheado para poder invalidarlo sin exponerlo
  refreshHash  String   @unique
  userAgent    String?
  ip           String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([expiresAt])
}



model Student {
  id      Int   @id @default(autoincrement())
  userId  Int   @unique
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  drivingClasses DrivingClass[]
}

model Car {
  id           Int         @id @default(autoincrement())
  brand        String
  model        String
  year         Int
  licensePlate String      @unique
  transmission Transmission

  instructorId Int      
  instructor   Instructor?  @relation(fields: [instructorId], references: [id])
}

model Instructor {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber   String
  experienceYears Int
  available       Boolean   @default(true)
  isValid         Boolean   @default(false)

  cars      Car[]  
  drivingClasses DrivingClass[]
  permissions     InstructorPermission[]
}

model Admin {
  id      Int  @id
  user    User @relation(fields: [id], references: [id])
  // Campos propios del administrador/cliente
  companyName String
} 

model Permission {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  isMandatory Boolean  @default(true)

  instructors InstructorPermission[]
}

model InstructorPermission {
  instructorId Int
  permissionId Int
  granted      Boolean     @default(false)

  instructor   Instructor  @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  permission   Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([instructorId, permissionId])
}

model DrivingClass {
  id           Int       @id @default(autoincrement())
  date         DateTime  @default(now())
  duration     Int       // duración en minutos
  status       String    @default("scheduled") // scheduled | completed | canceled
  notes        String?   // comentarios opcionales

  studentId    Int
  student      Student   @relation(fields: [studentId], references: [id])

  instructorId Int
  instructor   Instructor @relation(fields: [instructorId], references: [id])

  payments     Payment[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Payment {
  id                 Int       @id @default(autoincrement())
  amount             Float
  status             String    @default("pending") // pending | paid | failed
  paymentMethod      String    // cash | card | transfer | mercadopago
  drivingClassId     Int
  drivingClass       DrivingClass @relation(fields: [drivingClassId], references: [id])

  // Mercado Pago specific fields
  preferenceId       String?   // Mercado Pago preference ID
  paymentId          String?   // Mercado Pago payment ID
  externalReference  String?   // External reference for Mercado Pago

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}


