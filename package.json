{
  "name": "ManejApp",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "scripts": {
    "start": "node --run build && node dist/index.js",
    "dev": "ts-node-dev --watch --clear --quiet -r tsconfig-paths/register src/index.ts ",
    "build": "tsc && tsc-alias",
    "dev:ngrok": "concurrently \"npm run dev\" \"ngrok http 3000\"",
    "dev:tunnel": "concurrently \"npm run dev\" \"npx localtunnel --port 3000\"",
    "ngrok": "ngrok http 3000",
    "tunnel": "npx localtunnel --port 3000",
    "setup:logging": "node scripts/setup-logging.js",
    "logs:tail": "tail -f logs/app.log",
    "logs:clean": "rm -rf logs/*.log"
  },
  "type": "commonjs",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.13.1",
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cookie": "^1.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^2.8.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@types/cookie": "^1.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^8.2.2",
    "prisma": "^6.13.0",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  }
}