# =============================================================================
# ManejApp - Configuración de Variables de Entorno
# =============================================================================

# -----------------------------------------------------------------------------
# Base de Datos
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://username:password@localhost:5432/manejapp"

# -----------------------------------------------------------------------------
# Configuración JWT
# -----------------------------------------------------------------------------
JWT_SECRET="your-super-secret-jwt-key-minimum-32-characters-long"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-minimum-32-characters-long"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# -----------------------------------------------------------------------------
# Configuración de Cookies
# -----------------------------------------------------------------------------
COOKIE_SECRET="your-super-secret-cookie-key-minimum-32-characters-long"

# -----------------------------------------------------------------------------
# Configuración de Mercado Pago
# -----------------------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN="TEST-your-mercadopago-access-token-here"
MERCADOPAGO_PUBLIC_KEY="TEST-your-mercadopago-public-key-here"
APP_URL="http://localhost:3000"
APP_URL_PUBLIC="https://your-ngrok-url.ngrok.io"

# -----------------------------------------------------------------------------
# Configuración de la Aplicación
# -----------------------------------------------------------------------------
NODE_ENV="development"
PORT="3000"

# -----------------------------------------------------------------------------
# Sistema de Logging
# -----------------------------------------------------------------------------

# Nivel de logging (error, warn, info, debug)
LOG_LEVEL="debug"

# Habilitar/Deshabilitar Transports
ENABLE_CONSOLE_LOGS="true"           # Salida por consola (recomendado para desarrollo)
ENABLE_FILE_LOGS="true"              # Persistencia en archivos (recomendado siempre)
ENABLE_DATABASE_LOGS="false"         # Almacenamiento en BD (recomendado para producción)

# Configuración de Archivos de Log
LOG_DIRECTORY="./logs"               # Directorio donde se almacenan los logs
LOG_FILENAME="app.log"               # Nombre del archivo principal de logs
LOG_MAX_SIZE="50MB"                  # Tamaño máximo antes de rotación
LOG_MAX_FILES="10"                   # Número máximo de archivos rotados a mantener

# Configuración de Logging en Base de Datos
LOG_TABLE_NAME="logs"                # Nombre de la tabla para logs en BD
LOG_RETENTION_DAYS="30"              # Días de retención de logs en BD

# =============================================================================
# Notas de Configuración:
#
# 1. Para DESARROLLO:
#    - LOG_LEVEL="debug"
#    - ENABLE_CONSOLE_LOGS="true"
#    - ENABLE_FILE_LOGS="true"
#    - ENABLE_DATABASE_LOGS="false"
#
# 2. Para PRODUCCIÓN:
#    - LOG_LEVEL="info"
#    - ENABLE_CONSOLE_LOGS="false"
#    - ENABLE_FILE_LOGS="true"
#    - ENABLE_DATABASE_LOGS="true"
#
# 3. Para TESTING:
#    - LOG_LEVEL="error"
#    - ENABLE_CONSOLE_LOGS="true"
#    - ENABLE_FILE_LOGS="false"
#    - ENABLE_DATABASE_LOGS="false"
# =============================================================================