# Database
DATABASE_URL="postgresql://username:password@localhost:5432/manejapp"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-here"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server Configuration
PORT=3000
NODE_ENV="development"

# Mercado Pago Configuration
MERCADOPAGO_ACCESS_TOKEN="APP_USR-your-access-token"
MERCADOPAGO_PUBLIC_KEY="APP_USR-your-public-key"
MERCADOPAGO_WEBHOOK_SECRET="your-webhook-secret"

# Commission System
APP_COMMISSION_PERCENTAGE="20"
APP_COLLECTOR_ID="your-collector-id"

# Firebase (for push notifications)
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"your-project",...}'

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN="http://localhost:3000,https://yourdomain.com"

# Logging
LOG_LEVEL="info"
LOG_FILE_PATH="./logs"