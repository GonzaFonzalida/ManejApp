# Database
DATABASE_URL="postgresql://username:password@localhost:5432/manejapp"

# JWT Configuration (nombres exactos que lee config.ts)
JWT_SECRET="your-super-secret-jwt-key-minimum-10-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-minimum-10-chars"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
COOKIE_SECRET="your-super-secret-cookie-key-minimum-10-chars"

# Server Configuration
PORT=3099
NODE_ENV="development"
# Desarrollo: al arrancar el API se crea/actualiza admin@manejapp.com (rol ADMIN, demo). En producción no aplica. Deshabilitar: ENSURE_DEMO_ADMIN=0
# ENSURE_DEMO_ADMIN=0
# Desarrollo: al arrancar también se aseguran instructor@test.com y student@test.com (pass 123456) para listados admin. Deshabilitar: ENSURE_DEMO_CATALOG=0
# ENSURE_DEMO_CATALOG=0
# URL pública del API (webhooks MP, link en emails, GET /api/v1/config → baseUrl). Local: abajo. Render: https://manejapp-1.onrender.com
# En demo LAN podés usar http://TU_IP_LAN:3099 para iPhone en la misma red (opcional si usás --dart-define=API_URL en Flutter).
APP_URL="http://localhost:3099"

# Mercado Pago Configuration
MERCADOPAGO_ACCESS_TOKEN="APP_USR-your-access-token"
MERCADOPAGO_PUBLIC_KEY="APP_USR-your-public-key"
MERCADOPAGO_WEBHOOK_SECRET="your-webhook-secret"

# Commission System
APP_COMMISSION_PERCENTAGE="20"
APP_COLLECTOR_ID="your-collector-id"

# Google Sign-In (OAuth 2.0 Client ID - Web client from Google Cloud Console)
GOOGLE_CLIENT_ID=""

# Sign in with Apple — mismo valor que el Bundle ID de la app iOS (aud del identityToken)
APPLE_CLIENT_ID="com.gonzalofonzalida.manejapp"

# Firebase (for push notifications)
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"your-project",...}'

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN="http://localhost:3099,http://localhost:3001,https://yourdomain.com"

# Logging (LOG_DIRECTORY es el que usa config.ts)
LOG_LEVEL="info"
LOG_DIRECTORY="./logs"

# Email Configuration (for Gmail SMTP)
EMAIL_USER="manejapp.app@gmail.com"
EMAIL_PASS="webapp1234"

# Desarrollo: auto-verificar email al registrar (sin enviar correo). Útil para testeo local.
DEV_AUTO_VERIFY_EMAIL="true"

IS_MOBILE_APP="true"  # Set to "true" for mobile apps
MOBILE_APP_SCHEME="manejapp"  # Custom URL scheme for deep links (e.g., manejapp://verify-email)

# Report Configuration
REPORT_INTERVAL="weekly"  # daily, weekly, monthly
REPORT_EMAILS="admin1@example.com,admin2@example.com"  # Comma-separated list
ERROR_ALERTS_ENABLED="true"  # Send email alerts for critical errors